{
  "manifest_version": 3,
  "name": "DeepWiki to Markdown",
  "version": "0.3.0",
  "description": "Convert DeepWiki page content to Markdown format and save it",
  "permissions": [
    "downloads",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://deepwiki.com/*",
    "https://app.devin.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://deepwiki.com/*",
        "https://app.devin.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}